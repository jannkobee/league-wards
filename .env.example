# API mode: "direct" for local development or "netlify" for the deployed proxy.
VITE_API_MODE=direct

# Required only when VITE_API_MODE=direct. This value is exposed to the browser,
# so do not use direct mode in a public deployment.
VITE_API_KEY=your-riot-api-key

# Required in Netlify environment variables when VITE_API_MODE=netlify.
# It is included here only as documentation; do not put a production key in Git.
RIOT_API_KEY=your-riot-api-key
